{
  "name": "arcade-online",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/authority-*.test.cjs tests/original-maps.test.cjs tests/expanded-*.test.cjs",
    "test:bomb-p2": "node bomb_p2_e2e.js",
    "test:stream": "node stream_stability_test.js",
    "build:native": "node scripts/build-native.cjs",
    "typecheck": "tsc --noEmit",
    "test:native": "node --test tests/native-core.test.cjs tests/native-relay.test.cjs tests/badminton-core.test.cjs",
    "test:badminton:e2e": "node scripts/build-native.cjs && node tests/badminton-e2e.cjs",
    "test:native:e2e": "node tests/native-e2e.cjs",
    "test:deploy": "node --test tests/deploy.test.cjs",
    "test:authority": "node --test tests/authority-protocol.test.cjs tests/authority-engine.test.cjs tests/authority-relay.test.cjs tests/authority-presentation.test.cjs tests/authority-records.test.cjs tests/authority-mechanics.test.cjs tests/original-maps.test.cjs",
    "test:authority:e2e": "node tests/authority-e2e.cjs",
    "test:fullscreen:e2e": "node tests/fullscreen-e2e.cjs",
    "test:authority:weapons:e2e": "node tests/authority-weapons-e2e.cjs",
    "test:expanded": "node --test tests/expanded-*.test.cjs",
    "test:expanded:e2e": "node tests/expanded-e2e.cjs",
    "test:boxhead:assets:e2e": "node tests/expanded-boxhead-assets-e2e.cjs",
    "test:fidelity:e2e": "node scripts/build-native.cjs && node tests/fidelity-e2e.cjs",
    "test:bomb:restoration:e2e": "node scripts/build-native.cjs && node tests/bomb-restoration-e2e.cjs",
    "test:bomb:motion:e2e": "node scripts/build-native.cjs && node tests/bomb2-motion-e2e.cjs",
    "test:bomb:conveyor:e2e": "node scripts/build-native.cjs && node tests/bomb2-conveyor-e2e.cjs",
    "test:bomb:blasts:e2e": "node scripts/build-native.cjs && node tests/bomb2-blasts-e2e.cjs",
    "test:bomb:landforms:e2e": "node scripts/build-native.cjs && node tests/bomb2-landforms-e2e.cjs",
    "test:expanded:kill:e2e": "node scripts/build-native.cjs && node tests/expanded-kill-e2e.cjs",
    "test:lobby:e2e": "node tests/lobby-e2e.cjs",
    "package:linux": "node scripts/package-linux.cjs",
    "check:public": "node scripts/check-public.cjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.5.0",
    "typescript": "^7.0.2"
  }
}
